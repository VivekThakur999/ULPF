# ---------------------------------------------------------------------------
# ULPF Environment Configuration Template. Copy to `.env` and adjust.
# NEVER commit a real .env file. All secrets below MUST be changed for any
# non-local or production deployment.
#
# Variable Classifications:
#   [PUBLIC]       - Safe for frontend / reverse proxy visibility
#   [BACKEND ONLY] - Must only be exposed to backend services
#   [SECRET]       - Highly sensitive credential; never share or log
#   [OPTIONAL]     - Optional setting with sensible default
# ---------------------------------------------------------------------------

# --- General ---
# [BACKEND ONLY] [OPTIONAL]
ENVIRONMENT=development
DEBUG=true

# --- Database / Control Plane (Users, Roles, Rules, Parser Packs, Audit Logs) ---
# [BACKEND ONLY]
# Mode B (Local / Air-gapped zero-infra dev): SQLite
DATABASE_URL=sqlite:///./ulpf.db

# Mode A (Connected Mode - Supabase Cloud PostgreSQL with Connection Pooling):
# DATABASE_URL=postgresql+psycopg2://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Mode B (Local Docker Compose PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://ulpf:ulpf@db:5432/ulpf
POSTGRES_USER=ulpf
POSTGRES_PASSWORD=ulpf
POSTGRES_DB=ulpf

# --- Telemetry & Event Storage Plane (MongoDB Community Server 8.0) ---
# [BACKEND ONLY]
# Authoritative plane for: raw_logs, normalized_events, security_events,
# security_alerts, templates, compression_records, processing_jobs.
MONGODB_URI=mongodb://localhost:27017/ulpf_telemetry
MONGODB_DB_NAME=ulpf_telemetry
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=5
MONGODB_TIMEOUT_MS=2000
USE_MONGODB=true
MONGODB_ALLOW_MOCK=false
MONGODB_REQUIRE_LIVE=true

# --- Supabase Auth & Control Plane (Mode A - Connected Only) ---
# [BACKEND ONLY] [OPTIONAL in Air-Gapped Mode]
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
AUTH_MODE=auto                      # auto | supabase | local

# --- Auth / Security (Local Mode B) ---
# [BACKEND ONLY] [SECRET]
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_dev_only_insecure
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- CORS (comma separated) ---
# [BACKEND ONLY]
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# --- Privacy / PII Shield ---
# [BACKEND ONLY] [SECRET]
# HMAC key for deterministic pseudonymization. MUST be unique & secret.
PII_HMAC_KEY=CHANGE_ME_dev_only_pii_key
PII_DEFAULT_MODE=DETERMINISTIC_HASH  # OFF | MASK | DETERMINISTIC_HASH

# --- Ingestion Limits ---
# [BACKEND ONLY] [OPTIONAL]
MAX_UPLOAD_BYTES=52428800

# --- Bootstrap Admin (First run seed only) ---
# [BACKEND ONLY] [SECRET]
FIRST_ADMIN_EMAIL=admin@ulpf.io
FIRST_ADMIN_PASSWORD=ChangeMe!123

# --- Local AI Explainer (Always offline - zero cloud/network telemetry) ---
# [BACKEND ONLY] [OPTIONAL]
AI_PROVIDER=local_template          # local_template (deterministic) | disabled | ollama
OLLAMA_BASE_URL=http://localhost:11434   # only used when AI_PROVIDER=ollama
OLLAMA_MODEL=llama3.2                     # must already be pulled; never auto-downloaded
AI_MAX_CONTEXT_CHARS=6000
AI_MAX_RAW_INPUT_CHARS=16000
AI_OLLAMA_TIMEOUT_SECONDS=20

# --- Frontend (Build / Dev Only) ---
# [PUBLIC] [OPTIONAL]
VITE_API_TARGET=http://localhost:8000
